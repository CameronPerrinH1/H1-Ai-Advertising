{
  "name": "h1-ai-advertising",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "chat:check": "pnpm --dir concierge check",
    "chat:dev": "pnpm --dir concierge dev",
    "chat:test": "pnpm --filter \"@concierge/*\" --if-present test",
    "chat:typecheck": "pnpm --filter \"@concierge/*\" --if-present typecheck"
  },
  "dependencies": {
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.7.2"
  }
}
