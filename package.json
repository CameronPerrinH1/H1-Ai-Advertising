{
  "name": "h1-ai-advertising",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "chat:check": "pnpm --dir concierge check",
    "chat:dev": "pnpm --dir concierge dev",
    "chat:test": "pnpm --filter \"@concierge/*\" --if-present test",
    "chat:typecheck": "pnpm --filter \"@concierge/*\" --if-present typecheck",
    "test": "vitest run --config vitest.site.config.ts",
    "intake": "tsx --env-file-if-exists=.env.local scripts/intake.ts",
    "export-playbook": "tsx --env-file-if-exists=.env.local scripts/export-playbook.ts",
    "gaps": "tsx --env-file-if-exists=.env.local scripts/gaps.ts",
    "db:generate:intake": "drizzle-kit generate --config drizzle.intake.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1162.0",
    "@aws-sdk/client-sesv2": "^3.1162.0",
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.3",
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
